{
	"deno.enable": true,
	"deno.lint": true,
	"editor.defaultFormatter": "denoland.vscode-deno",
	"editor.suggest.showStatusBar": true,
	"editor.quickSuggestions": {
		"strings": true
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "denoland.vscode-deno",
		"editor.formatOnSave": true
	},
	"[typescript]": {
		"editor.defaultFormatter": "denoland.vscode-deno",
		"editor.formatOnSave": true
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "denoland.vscode-deno",
		"editor.formatOnSave": true
	},
	"[javascript]": {
		"editor.defaultFormatter": "denoland.vscode-deno",
		"editor.formatOnSave": true
	}
}
