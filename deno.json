{
  "tasks": {
    "start": "deno run -A --watch=static/,routes/ dev.ts"
  },
  "importMap": "./import_map.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true
  },
  "fmt": {
    "files": {
      "include": ["components/", "islands/", "routes/", "utils/", "main.ts", "dev.ts"],
      "exclude": ["fresh.gen.ts"]
    },
		"options": {
			"useTabs": true,
			"lineWidth": 80,
			"indentWidth": 4,
			"singleQuote": true,
			"semiColons": false,
			"proseWrap": "preserve"
		}
  }
}
