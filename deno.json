{
	"lock": false,
	"tasks": {
		"check": "deno fmt --check && deno lint && deno check **/*.ts && deno check **/*.tsx",
		"start": "deno run -A --unstable --watch=static/,routes/,data/,utils/,components/,service/ dev.ts",
		"build": "deno run -A dev.ts build",
		"preview": "deno run -A main.ts",
		"update": "deno run -A -r https://fresh.deno.dev/update ."
	},
	"lint": { "rules": { "tags": ["fresh", "recommended"] } },
	"fmt": {
		"useTabs": true,
		"lineWidth": 90,
		"indentWidth": 4,
		"semiColons": false,
		"singleQuote": true,
		"proseWrap": "preserve"
	},
	"imports": {
		"$fresh/": "https://deno.land/x/fresh@1.5.1/",
		"preact": "https://esm.sh/preact@10.18.1",
		"preact/": "https://esm.sh/preact@10.18.1/",
		"preact-render-to-string": "https://esm.sh/*preact-render-to-string@6.2.2",
		"@preact/signals": "https://esm.sh/*@preact/signals@1.2.1",
		"@preact/signals-core": "https://esm.sh/*@preact/signals-core@1.5.0",
		"frontmatter": "https://deno.land/x/frontmatter@v0.1.5/mod.ts",
		"twind": "https://esm.sh/twind@0.16.19",
		"twind/": "https://esm.sh/twind@0.16.19/",
		"$std/": "https://deno.land/std@0.202.0/",
		"gfm": "https://deno.land/x/gfm@0.2.1/mod.ts",
		"jose": "https://deno.land/x/jose@v4.14.6/index.ts"
	},
	"compilerOptions": { "jsx": "react-jsx", "jsxImportSource": "preact" },
	"exclude": ["**/_fresh/*"]
}
